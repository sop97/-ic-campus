# IC-Campus — Variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" et remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Credentials de l'API Flask
API_USER=icadmin
API_PASSWORD=ic@2024

# Chemin du fichier de données dans le conteneur API
CATALOG_PATH=/data/catalog.json

# Valeur base64 de "API_USER:API_PASSWORD" — utilisée par nginx pour
# construire l'en-tête Authorization vers l'API.
# Calculez cette valeur avec la commande appropriée sur votre système.
API_BASIC_AUTH=
